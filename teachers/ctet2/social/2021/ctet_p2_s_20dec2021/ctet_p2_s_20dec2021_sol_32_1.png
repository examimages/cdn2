  <div id="cb-await-loader"
    style="display:none;background-color:rgba(0,0,0,0.6);z-index: 90000000000;position:fixed;left:50%;top:50%;transform:translate(-50%,-50.1%);width:100%;height:100%;backdrop-filter: blur(5px);">
