      style="width: 200px;padding:20px;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background: white;border-radius: 5px;">
      <div
        style="margin:auto; width: 70px;height: 90px;background: url(/assets/img/utility/loader.gif) no-repeat 50% 50%;">
